# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (replica set required for multi-document transactions)
MONGO_URI=mongodb://127.0.0.1:27017/ops_erp?replicaSet=rs0

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
