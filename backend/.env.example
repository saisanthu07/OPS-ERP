# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Supabase / PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxx.supabase.co:5432/postgres"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false
